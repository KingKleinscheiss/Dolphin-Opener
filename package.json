{
  "name": "dolphin-opener",
  "version": "0.1.0",
  "description": "Local tool that drives Dolphin{anty} profiles through a proxy-rotating slot pipeline.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,frontend \"tsx watch src/index.ts\" \"vite --config frontend/vite.config.ts\"",
    "build": "tsc -p tsconfig.json && vite build --config frontend/vite.config.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p frontend/tsconfig.json"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/static": "^8.0.2",
    "@fastify/websocket": "^11.0.1",
    "playwright-core": "^1.48.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
